<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recordatorios de fecha límite de pago de las tarjetas -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Para poder mostrar el icono de las apps de tus bancos como logo de cada tarjeta -->
    <queries>
        <package android:name="com.bancomer.mbanking" />
        <package android:name="com.nu.production" />
        <package android:name="com.grability.rappi" />
        <package android:name="com.citibanamex.banamexmobile" />
        <package android:name="com.mercadopago.wallet" />
        <package android:name="com.google.android.apps.walletnfcrel" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_agenda"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ventana flotante de captura rápida que abre el widget -->
        <activity
            android:name=".CapturaRapidaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <receiver
            android:name=".widget.FinanzasWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/finanzas_widget_info" />
        </receiver>

        <!-- Escucha las notificaciones de Google Wallet para registrar cada pago -->
        <service
            android:name=".WalletListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
