<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Recordatorios de fecha límite de pago de las tarjetas -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Pedir huella, rostro o PIN al abrir la app -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Guardar dónde fue cada compra en persona (una lectura por pago, no se sigue tu ubicación) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- El pago llega con la app cerrada: sin esto Android no da la ubicación al lector de notificaciones -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- Dibujar el mapa y escribir la dirección -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Saber si estás en el WiFi de casa antes de subir el respaldo semanal a Drive -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Para poder mostrar el icono de las apps de tus bancos como logo de cada tarjeta -->
    <queries>
        <package android:name="com.bancomer.mbanking" />
        <package android:name="com.nu.production" />
        <package android:name="com.grability.rappi" />
        <package android:name="com.citibanamex.banamexmobile" />
        <package android:name="com.mercadopago.wallet" />
        <package android:name="com.google.android.apps.walletnfcrel" />
    </queries>

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@android:drawable/ic_menu_agenda"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Ventana flotante de captura rápida que abre el widget -->
        <activity
            android:name=".CapturaRapidaActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <receiver
            android:name=".widget.FinanzasWidgetReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/finanzas_widget_info" />
        </receiver>

        <!-- Escucha las notificaciones de Google Wallet para registrar cada pago -->
        <service
            android:name=".WalletListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
